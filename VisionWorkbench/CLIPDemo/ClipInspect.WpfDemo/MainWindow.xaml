<Window x:Class="ClipInspect.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClipInspect WPF Demo" Height="780" Width="1220"
        MinHeight="660" MinWidth="1040">
    <Grid Background="#F6F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="12">
            <TabItem Header="Cache 构建">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="数据库" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="DatabasePathTextBox" IsReadOnly="True" Height="30" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="选择/创建" Width="96" Height="30" Margin="8,0,0,0" Click="SelectDatabase_Click"/>
                            <Button Grid.Column="3" Content="查询产品" Width="88" Height="30" Margin="8,0,0,0" Click="RefreshProducts_Click"/>
                            <ComboBox Grid.Column="4" x:Name="ProductComboBox" Width="150" Height="30" Margin="8,0,0,0" SelectionChanged="ProductComboBox_SelectionChanged"/>
                            <Button Grid.Column="5" Content="刷新样本" Width="88" Height="30" Margin="8,0,0,0" Click="RefreshSamples_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" Padding="12" Margin="0,10,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Product" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="ProductIdTextBox" Width="130" Height="30" Text="part_A" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Top K" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="BuildTopKTextBox" Width="52" Height="30" Text="3" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="阈值" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="BuildThresholdTextBox" Width="72" Height="30" Text="0.94" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="加载 OK 图" Width="96" Height="30" Margin="0,0,8,0" Click="AddPendingOk_Click"/>
                            <Button Content="加载 NG 图" Width="96" Height="30" Margin="0,0,8,0" Click="AddPendingNg_Click"/>
                            <Button Content="清空待构建" Width="96" Height="30" Margin="0,0,8,0" Click="ClearPending_Click"/>
                            <Button Content="构建/追加" Width="96" Height="30" Click="BuildToDatabase_Click"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="待构建 OK" FontWeight="SemiBold" Padding="10" Background="#FDFDFE"/>
                                <ListBox x:Name="PendingOkListBox" BorderThickness="0" DisplayMemberPath="Display"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="待构建 NG" FontWeight="SemiBold" Padding="10" Background="#FDFDFE"/>
                                <ListBox x:Name="PendingNgListBox" BorderThickness="0" DisplayMemberPath="Display"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Background="#FDFDFE">
                                        <TextBlock Text="数据库 OK 样本" FontWeight="SemiBold" Padding="10"/>
                                        <Button DockPanel.Dock="Right" Content="删除选中" Width="86" Height="28" Margin="0,6,8,6" Click="DeleteSelectedOk_Click"/>
                                    </DockPanel>
                                    <ListBox x:Name="DbOkListBox" BorderThickness="0" DisplayMemberPath="Display" SelectionChanged="DatabaseSample_SelectionChanged"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Background="#FDFDFE">
                                        <TextBlock Text="数据库 NG 样本" FontWeight="SemiBold" Padding="10"/>
                                        <Button DockPanel.Dock="Right" Content="删除选中" Width="86" Height="28" Margin="0,6,8,6" Click="DeleteSelectedNg_Click"/>
                                    </DockPanel>
                                    <ListBox x:Name="DbNgListBox" BorderThickness="0" DisplayMemberPath="Display" SelectionChanged="DatabaseSample_SelectionChanged"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="推理测试">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" Padding="12">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Product" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="InferProductComboBox" Width="150" Height="30" Margin="0,0,12,0"/>
                            <TextBlock Text="Top K" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="InferTopKTextBox" Width="52" Height="30" Text="3" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="阈值" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="InferThresholdTextBox" Width="72" Height="30" Text="0.94" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="选择图片" Width="96" Height="30" Margin="0,0,8,0" Click="SelectInferImage_Click"/>
                            <Button Content="推理" Width="78" Height="30" Click="Inspect_Click"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12"/>
                                <TextBlock x:Name="ImagePlaceholderTextBlock" Text="选择图片后预览"
                                           Foreground="#98A2B3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ResultTextBlock" Text="等待推理" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" x:Name="ScoreTextBlock" TextWrapping="Wrap" Foreground="#344054" Margin="0,0,0,8"/>
                                <TextBox Grid.Row="2" x:Name="TopKResultTextBox" IsReadOnly="True" BorderThickness="0"
                                         Background="#FFFFFF" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" Padding="10">
                        <TextBlock x:Name="TimingTextBlock" Foreground="#667085"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#667085"/>
        </Border>
    </Grid>
</Window>
