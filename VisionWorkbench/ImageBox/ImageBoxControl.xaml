<UserControl x:Class="ImageBox.ImageBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="#2A2F37" BorderThickness="1" Background="#101419">
            <Canvas x:Name="MainCanvas"
                    Background="#101419"
                    ClipToBounds="True"
                    Focusable="True"
                    MouseWheel="MainCanvas_MouseWheel"
                    PreviewMouseLeftButtonDown="MainCanvas_PreviewMouseLeftButtonDown"
                    MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                    MouseRightButtonDown="MainCanvas_MouseRightButtonDown"
                    MouseMove="MainCanvas_MouseMove">
                <Grid x:Name="ImageLayer"
                      RenderOptions.BitmapScalingMode="HighQuality">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image x:Name="DisplayImage" Stretch="Fill" />
                    <Canvas x:Name="OverlayCanvas"
                            ClipToBounds="False"
                            IsHitTestVisible="True" />
                </Grid>
            </Canvas>
        </Border>

        <StackPanel x:Name="InfoOverlayPanel"
                    Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="8">
            <TextBlock x:Name="ScaleInfoText"
                       Foreground="White"
                       Background="#AA000000"
                       Padding="6,3"
                       Text="缩放: 100%" />
            <TextBlock x:Name="CoordinateInfoText"
                       Foreground="White"
                       Background="#AA000000"
                       Padding="6,3"
                       Margin="0,3,0,0"
                       Text="坐标: (-, -)" />
            <TextBlock x:Name="BrightnessInfoText"
                       Foreground="White"
                       Background="#AA000000"
                       Padding="6,3"
                       Margin="0,3,0,0"
                       Text="灰度: -" />
        </StackPanel>

        <Canvas x:Name="VisualCursorLayer"
                IsHitTestVisible="False">
            <Path x:Name="VisualCursorOuter"
                  Visibility="Collapsed"
                  Stroke="#F2FFFFFF"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
            <Path x:Name="VisualCursorInner"
                  Visibility="Collapsed"
                  Stroke="#FF00BFFF"
                  StrokeThickness="1.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Canvas>
    </Grid>
</UserControl>
