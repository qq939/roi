<Window x:Class="VisionWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VisionWorkbench.ViewModels"
        xmlns:views="clr-namespace:VisionWorkbench.Views"
        mc:Ignorable="d"
        Title="视觉检测工作台"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Icon="Assets/AMSLogo.png"
        WindowStartupLocation="CenterScreen"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeWorkspaceViewModel}">
            <views:HomeWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CameraOverviewViewModel}">
            <views:CameraOverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CameraDetailViewModel}">
            <views:CameraDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductModelManagementViewModel}">
            <views:ProductModelManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskSettingsViewModel}">
            <views:TaskSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClipTrainingLibraryViewModel}">
            <views:ClipTrainingLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InspectionResultQueryViewModel}">
            <views:InspectionResultQueryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CameraSettingsViewModel}">
            <views:CameraSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParameterSettingsViewModel}">
            <views:ParameterSettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="200"
                            Height="38"
                            Background="White"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,3">
                        <Image Source="pack://application:,,,/Assets/tk_trane_logo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border Width="1"
                            Height="22"
                            Background="{StaticResource AppBorderBrush}"
                            Margin="14,0" />

                    <TextBlock Text="成品号"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Border Width="200"
                            Height="32"
                            Background="White"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,0">
                        <TextBox x:Name="ProductCodeInput"
                                 Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 FontSize="14" />
                    </Border>

                    <TextBlock Text="序列号"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="16,0,6,0" />
                    <Border Width="200"
                            Height="32"
                            Background="White"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,0">
                        <TextBox x:Name="SerialNumberInput"
                                 Text="{Binding SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 FontSize="14" />
                    </Border>

                    <TextBlock Text="相机"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="16,0,6,0" />
                    <ComboBox Width="140"
                              Height="32"
                              ItemsSource="{Binding Cameras}"
                              SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              VerticalContentAlignment="Center" />

                    <Border Width="1"
                            Height="22"
                            Background="{StaticResource AppBorderBrush}"
                            Margin="14,0" />
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding RunStateBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0" />
                    <TextBlock Text="{Binding RunStateText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding StartCommand}"
                            Background="{StaticResource SuccessBrush}"
                            BorderBrush="{StaticResource SuccessBrush}"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}"
                                       Text="&#xE768;"
                                       FontSize="13"
                                       Foreground="White"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="启动" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding StopCommand}"
                            Background="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}"
                                       Text="&#xE71A;"
                                       FontSize="13"
                                       Foreground="White"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="停止" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding TriggerCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}"
                                       Text="&#xE722;"
                                       FontSize="13"
                                       Foreground="White"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="手动触发" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="2"
                        Margin="18,0,12,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasAlarm, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding ToggleAlarmCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip="{Binding AlarmToggleTooltip}">
                            <Border Height="34"
                                    Padding="8,0"
                                    Background="#FEF2F2"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <!-- Collapsed view: single line with ellipsis -->
                                    <TextBlock Text="{Binding AlarmText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource DangerBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding AlarmExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <!-- Expanded view: full text with wrapping -->
                                    <TextBlock Text="{Binding AlarmText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource DangerBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding AlarmExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button Grid.Column="1"
                                Command="{Binding DismissAlarmCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                ToolTip="关闭告警">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource DangerBrush}" />
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}"
                                  Margin="0,8,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Rail"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}"
                                             ToolTip="{Binding Title}"
                                             ToolTipService.InitialShowDelay="250">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton" BasedOn="{StaticResource RailButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTopDivider}" Value="True">
                                                    <Setter Property="Margin" Value="0,14,0,2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>

                                    <Grid Width="44" Height="44">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{Binding IconGlyph}" />
                                        <Border Width="17"
                                                Height="17"
                                                CornerRadius="8.5"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,4,4"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding BadgeText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ContentControl Grid.Column="1"
                            Margin="8"
                            Content="{Binding CurrentWorkspace}" />
        </Grid>

    </Grid>
</Window>
