<Window x:Class="VisionWorkbench.SecondaryBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:imagebox="clr-namespace:ImageBox;assembly=ImageBox"
        xmlns:behaviors="clr-namespace:VisionWorkbench.Behaviors"
        Title="视觉检测工作台"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="540"
        Icon="Assets/AMSLogo.png"
        Background="{Binding BackgroundBrush}"
        WindowStartupLocation="Manual">
    <Grid Background="{Binding BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B1220"
                BorderBrush="#253044"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        BorderBrush="#D9E1EA"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                    <Image Source="pack://application:,,,/Assets/tk_trane_logo.png"
                           Width="318"
                           Height="50"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="22,0"
                            TextElement.Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding HomeWorkspace.ProductCode, StringFormat=成品号：{0}, TargetNullValue=成品号：--}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  |  "
                                   FontSize="32"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding HomeWorkspace.SerialNumber, StringFormat=SN：{0}, TargetNullValue=SN：--}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{Binding HomeWorkspace.TotalResultBackground}"
                        CornerRadius="8"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="总结果"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="6,0,16,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HomeWorkspace.TotalResultText}"
                                   Foreground="White"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextAlignment="Left"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Cameras}"
                      Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                 Rows="{Binding DataContext.Rows, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="6" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0F172A"
                            BorderBrush="#2D3A52"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="#162033"
                                    BorderBrush="#2D3A52"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="{Binding Camera.ConnectionBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Camera.Name}"
                                               Foreground="White"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Camera.LastFrameInfo}"
                                               Foreground="#CBD5E1"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <imagebox:ImageBoxControl Grid.Row="1"
                                                      ImageSource="{Binding Camera.Frame}"
                                                      OverlayItems="{Binding Camera.Overlays}"
                                                      InteractionMode="Pan"
                                                      ShowInfoOverlay="False"
                                                      ShowBrightnessInfo="False"
                                                      behaviors:ImageBoxViewportBridge.PreserveViewport="True"
                                                      behaviors:ImageBoxViewportBridge.ViewScale="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      behaviors:ImageBoxViewportBridge.ViewOffsetX="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      behaviors:ImageBoxViewportBridge.ViewOffsetY="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
