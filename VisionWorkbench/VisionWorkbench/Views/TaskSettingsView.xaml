<UserControl x:Class="VisionWorkbench.Views.TaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:imagebox="clr-namespace:ImageBox;assembly=ImageBox"
             xmlns:services="clr-namespace:VisionWorkbench.Services"
             mc:Ignorable="d">
    <UserControl.Resources>
        <services:MeasurementEdgePolarityTextConverter x:Key="MeasurementEdgePolarityTextConverter" />
        <services:InspectionTaskKindTextConverter x:Key="InspectionTaskKindTextConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="336" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <TextBlock Text="任务设置"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="1" Margin="14,12,14,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="成品号"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ProductModels}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProductModel, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1"
                               Text="相机"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding Cameras}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                              Margin="0,6,0,0" />
                </Grid>

                <Grid Grid.Row="2" Margin="14,0,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图像模式"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <RadioButton Content="模板编辑"
                                     GroupName="TaskImageMode"
                                     IsChecked="{Binding IsTemplateEditMode, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,14,0" />
                        <RadioButton Content="测试预览"
                                     GroupName="TaskImageMode"
                                     IsChecked="{Binding IsTestPreviewMode, Mode=TwoWay}"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="14,0,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <Button Content="测试拍照"
                                Style="{StaticResource ToolbarButton}"
                                MinWidth="76"
                                Command="{Binding CaptureImageCommand}"
                                IsEnabled="{Binding IsTestPreviewMode}" />
                        <Button Content="测试读图"
                                Style="{StaticResource ToolbarButton}"
                                MinWidth="76"
                                Command="{Binding LoadImageCommand}"
                                IsEnabled="{Binding IsTestPreviewMode}" />
                    </WrapPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding TestPreviewResultText}"
                             Height="96"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,8,0,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTestPreviewMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="14,0">
                        <Grid>
                            <TextBlock Text="任务"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding AddTaskCommand}"
                                        IsEnabled="{Binding CanAddTask}"
                                        ToolTip="添加任务">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" />
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding DeleteTaskCommand}"
                                        IsEnabled="{Binding CanDeleteTask}"
                                        ToolTip="删除任务"
                                        Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding TaskItems}"
                             SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="10,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <Border Grid.Column="1"
                                                        MinWidth="32"
                                                        Height="22"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Right"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding PreviewResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PreviewResult}" Value="OK">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PreviewResult}" Value="NG">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding PreviewResult}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource InspectionTaskKindTextConverter}}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="OK:{0:0.0000} NG:{1:0.0000}">
                                                        <Binding Path="PreviewOkScore" />
                                                        <Binding Path="PreviewNgScore" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding DataContext.CanEditTaskParameters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource AppBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" />

        <Border Grid.Column="2"
                Style="{StaticResource PanelBorder}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCamera.Name}"
                                       Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedProductModel.Name}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <imagebox:ImageBoxControl Grid.Row="1"
                                          ImageSource="{Binding CurrentImage}"
                                          OverlayItems="{Binding TaskOverlays}"
                                          InteractionMode="{Binding CurrentInteractionMode}"
                                          RoiDrawCompleted="ImageBox_RoiDrawCompleted"
                                          RoiDrawRejected="ImageBox_RoiDrawRejected"
                                          OverlayItemSelected="ImageBox_OverlayItemSelected"
                                          OverlayItemEditCompleted="ImageBox_OverlayItemEditCompleted"
                                          ShowInfoOverlay="False"
                                          ShowBrightnessInfo="False" />
            </Grid>
        </Border>

        <GridSplitter Grid.Column="3"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource AppBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" />

        <Border Grid.Column="4"
                Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <TextBlock Text="任务参数"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="1"
                      Margin="14,12"
                      IsEnabled="{Binding CanEditTaskParameters}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="名称"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Grid.ColumnSpan="3"
                             Text="{Binding SelectedTask.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1"
                               Text="类型"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Grid.ColumnSpan="3"
                              ItemsSource="{Binding TaskKindOptions}"
                              SelectedItem="{Binding SelectedTask.Kind, Mode=TwoWay}"
                              Margin="0,8,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource InspectionTaskKindTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               Text="启用"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              IsChecked="{Binding SelectedTask.Enabled, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,8,0,0" />

                    <Border Grid.Row="3"
                            Grid.ColumnSpan="4"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,16,0,12" />

                    <TextBlock Grid.Row="4"
                               Grid.ColumnSpan="4"
                               Text="ROI"
                               Style="{StaticResource SectionTitle}"
                               FontSize="13" />

                    <TextBlock Grid.Row="5"
                               Text="中心X"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             Text="{Binding SelectedTask.RoiX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                             Margin="0,8,8,0" />
                    <TextBlock Grid.Row="5"
                               Grid.Column="2"
                               Text="中心Y"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <TextBox Grid.Row="5"
                             Grid.Column="3"
                             Text="{Binding SelectedTask.RoiY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                             Margin="0,8,0,0" />

                    <TextBlock Grid.Row="6"
                               Text="宽"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Text="{Binding SelectedTask.RoiWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                             Margin="0,8,8,0" />
                    <TextBlock Grid.Row="6"
                               Grid.Column="2"
                               Text="高"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <TextBox Grid.Row="6"
                             Grid.Column="3"
                             Text="{Binding SelectedTask.RoiHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                             Margin="0,8,0,0" />

                    <TextBlock Grid.Row="7"
                               Text="角度"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0" />
                    <TextBox Grid.Row="7"
                             Grid.Column="1"
                             Text="{Binding SelectedTask.RoiAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                             Margin="0,8,8,0" />

                    <Button Grid.Row="7"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Content="重绘 ROI"
                            Style="{StaticResource ToolbarButton}"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            Command="{Binding RedrawRoiCommand}"
                            IsEnabled="{Binding CanRedrawRoi}" />

                    <Border Grid.Row="8"
                            Grid.ColumnSpan="4"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,14,0,0" />

                    <Grid Grid.Row="9"
                          Grid.ColumnSpan="4"
                          Margin="0,14,0,0"
                          Visibility="{Binding SelectedTask.IsClassificationTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="4"
                                   Text="分类判定"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13" />

                        <TextBlock Grid.Row="1"
                                   Text="OK阈值"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding SelectedTask.ClassificationThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.000}"
                                 ToolTip="OK 分数达到该值时判定为 OK；范围 0.001 到 1.000。"
                                 Margin="0,8,8,0" />
                    </Grid>

                    <Grid Grid.Row="9"
                          Grid.ColumnSpan="4"
                          Margin="0,14,0,0"
                          Visibility="{Binding SelectedTask.IsMeasurementTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="4"
                                   Text="测量"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13" />

                        <TextBlock Grid.Row="1"
                                   Text="边1"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding MeasurementEdgePolarityOptions}"
                                  SelectedItem="{Binding SelectedTask.FirstEdgePolarity, Mode=TwoWay}"
                                  Margin="0,8,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource MeasurementEdgePolarityTextConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="边2"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="3"
                                  ItemsSource="{Binding MeasurementEdgePolarityOptions}"
                                  SelectedItem="{Binding SelectedTask.SecondEdgePolarity, Mode=TwoWay}"
                                  Margin="0,8,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource MeasurementEdgePolarityTextConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Text="下限(mm)"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding SelectedTask.MinDistanceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                 Margin="0,8,8,0" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="上限(mm)"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="3"
                                 Text="{Binding SelectedTask.MaxDistanceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                 Margin="0,8,0,0" />

                        <TextBlock Grid.Row="3"
                                   Text="当前值(mm)"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding CurrentMeasurementValueText}"
                                 Foreground="{Binding CurrentMeasurementStatusBrush}"
                                 ToolTip="{Binding CurrentMeasurementToolTip}"
                                 FontWeight="SemiBold"
                                 IsReadOnly="True"
                                 Margin="0,8,8,0" />

                        <Button Grid.Row="3"
                                Grid.Column="3"
                                Content="Profile"
                                Style="{StaticResource HeaderActionButton}"
                                Foreground="Black"
                                Margin="0,8,0,0"
                                Command="{Binding ShowMeasurementProfileCommand}"
                                IsEnabled="{Binding CanShowMeasurementProfile}" />
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <Button Content="保存"
                            Style="{StaticResource HeaderActionButton}"
                            Background="{StaticResource SuccessBrush}"
                            BorderBrush="{StaticResource SuccessBrush}"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveCommand}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
