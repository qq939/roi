<Window x:Class="VisionWorkbench.Views.TaskSampleLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <TextBlock Text="任务样本库"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="刷新"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding RefreshCommand}" />
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1"
                           Margin="14,10,14,8">
                    <Button Content="改为OK"
                            Style="{StaticResource HeaderActionButton}"
                            Background="{StaticResource SuccessBrush}"
                            BorderBrush="{StaticResource SuccessBrush}"
                            Command="{Binding MarkSelectedOkCommand}" />
                    <Button Content="改为NG"
                            Style="{StaticResource HeaderActionButton}"
                            Background="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Command="{Binding MarkSelectedNgCommand}" />
                    <Button Content="忽略"
                            Style="{StaticResource ToolbarButton}"
                            Command="{Binding IgnoreSelectedCommand}" />
                    <Button Content="删除"
                            Style="{StaticResource ToolbarButton}"
                            Command="{Binding DeleteSelectedCommand}" />
                </WrapPanel>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Samples}"
                         SelectedItem="{Binding SelectedSample, Mode=TwoWay}"
                         Margin="14,0,14,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="9"
                                    Margin="0,0,0,7"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding FileName}"
                                               ToolTip="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Border Grid.Column="1"
                                            Background="{Binding StateBackground}"
                                            BorderBrush="{Binding StateBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StateText}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock Text="{Binding DetailText}"
                                               Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="统计"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13"
                                   Margin="0,0,0,6" />
                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding SummaryText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource ImageBackBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="未选择样本"
                           Foreground="#AAB4C2"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{Binding SelectedSample.StateBackground}"
                        BorderBrush="{Binding SelectedSample.StateBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4"
                        Margin="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSample}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SelectedSample.StateText}"
                               Foreground="{Binding SelectedSample.StateBrush}"
                               FontWeight="SemiBold" />
                </Border>
                <Border VerticalAlignment="Bottom"
                        Background="#CC111827"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewTitle}"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PreviewDetail}"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#FDE68A"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
