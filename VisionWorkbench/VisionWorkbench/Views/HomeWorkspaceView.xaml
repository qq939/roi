<UserControl x:Class="VisionWorkbench.Views.HomeWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="330" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="0"
                        Content="{Binding CurrentImageWorkspace}" />

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource AppBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" />

        <Border Grid.Column="2"
                Style="{StaticResource PanelBorder}"
                Margin="2,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="154" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="236" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding SelectedCamera.ConnectionBrush}"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="检测"
                                       Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedCamera.Name}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{Binding TotalResultBackground}"
                            CornerRadius="6"
                            Padding="12,8">
                        <Grid>
                            <TextBlock Text="总结果"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top" />
                            <TextBlock Text="{Binding TotalResultText}"
                                       Foreground="White"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Cameras.Count}"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="相机" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding OkCount}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="OK" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding NgCount}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="NG" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="成品号"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1"
                                   Text="序列号"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,0,0" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0" />

                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,6,0"
                                     ToolTip="{Binding BarcodeScanner.StatusText}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BarcodeScanner.IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="扫码枪"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerButtonActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="启动 DI0"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResetButtonActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="复位 DI1"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding BarcodeScanner.LastBarcode}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="4"
                                   Text="{Binding BarcodeScanner.LastBarcodeTimeText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <DataGrid Grid.Row="4"
                          ItemsSource="{Binding Results}">
                    <DataGrid.Resources>
                        <Style x:Key="CenteredResultTextStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                        <Style TargetType="{x:Type DataGridColumnHeader}"
                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style TargetType="{x:Type DataGridCell}"
                               BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="相机" Binding="{Binding CameraName}" Width="70"
                                            ElementStyle="{StaticResource CenteredResultTextStyle}" />
                        <DataGridTextColumn Header="项目" Binding="{Binding Item}" Width="*"
                                            ElementStyle="{StaticResource CenteredResultTextStyle}" />
                        <DataGridTemplateColumn Header="值" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}"
                                               ToolTip="{Binding DetailText}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="判定" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Result}"
                                               Foreground="{Binding ResultBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="14,0">
                        <TextBlock Text="事件"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBox x:Name="EventTextBox"
                             Grid.Row="1"
                             Text="{Binding EventText, Mode=OneWay}"
                             TextChanged="EventTextBox_TextChanged"
                             Height="Auto"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             BorderThickness="0"
                             Padding="8,4"
                             FontFamily="Consolas"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextBrush}"
                             VerticalContentAlignment="Top"
                             HorizontalContentAlignment="Left"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
