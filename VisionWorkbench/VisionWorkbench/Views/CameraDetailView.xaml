<UserControl x:Class="VisionWorkbench.Views.CameraDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:imagebox="clr-namespace:ImageBox;assembly=ImageBox"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="980">
    <Border Style="{StaticResource PanelBorder}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="{Binding SelectedCamera.ResultBrush}"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SelectedCamera.Name}"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.LoadCameraImageCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding SelectedCamera}"
                                ToolTip="读取图片">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource IconGlyph}" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.InspectCameraImageCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding SelectedCamera}"
                                ToolTip="检测当前图像"
                                Margin="4,0,0,0">
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="15" />
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedCamera.Resolution}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedCamera.CycleTime}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Visibility="{Binding SelectedCamera.HasCycleTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Grid.Column="4"
                            Background="{Binding SelectedCamera.ResultBackBrush}"
                            CornerRadius="4"
                            Padding="10,3"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedCamera.HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedCamera.Result}"
                                   Foreground="{Binding SelectedCamera.ResultBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <imagebox:ImageBoxControl Grid.Row="1"
                                      ImageSource="{Binding SelectedCamera.Frame}"
                                      OverlayItems="{Binding SelectedCamera.Overlays}"
                                      InteractionMode="Pan"
                                      ShowInfoOverlay="False"
                                      ShowBrightnessInfo="False" />
        </Grid>
    </Border>
</UserControl>
