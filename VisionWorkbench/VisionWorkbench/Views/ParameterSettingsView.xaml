<UserControl x:Class="VisionWorkbench.Views.ParameterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#EDF1F6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Width" Value="116" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>

        <Style x:Key="SettingGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0">
                <Grid>
                    <TextBlock Text="参数设置"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeaderActionButton}"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Command="{Binding SaveSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;"
                                       Style="{StaticResource IconGlyph}"
                                       FontSize="14"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="保存" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <TextBlock Text="基础参数"
                               Style="{StaticResource SettingSectionTitle}" />

                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="图片根目录"
                                               Style="{StaticResource SettingLabel}" />

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Text="{Binding ImageArchiveRootDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="420" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ToolbarButton}"
                                                Margin="8,0,0,0"
                                                Command="{Binding BrowseImageRootDirectoryCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;"
                                                           Style="{StaticResource IconGlyph}"
                                                           FontSize="14"
                                                           Margin="0,0,6,0" />
                                                <TextBlock Text="选择路径" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="自动启动"
                                               Style="{StaticResource SettingLabel}" />
                                    <CheckBox Grid.Column="1"
                                              Content="打开软件后自动启动检测"
                                              IsChecked="{Binding AutoStartInspection, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="副屏看板"
                                               Style="{StaticResource SettingLabel}" />
                                    <CheckBox Grid.Column="1"
                                              Content="启动时自动打开"
                                              IsChecked="{Binding SecondaryBoardEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="看板布局"
                                               Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SecondaryBoardLayoutOptions}"
                                              SelectedItem="{Binding SelectedSecondaryBoardLayout, Mode=TwoWay}"
                                              Width="136"
                                              HorizontalAlignment="Left" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="看板背景色"
                                               Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Width="36"
                                                Height="24"
                                                Background="{Binding SecondaryBoardBackgroundBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,0,8,0" />
                                        <TextBox Text="{Binding SecondaryBoardBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="126" />
                                        <Button Content="调色板"
                                                Style="{StaticResource ToolbarButton}"
                                                Margin="8,0,0,0"
                                                Command="{Binding ChooseSecondaryBoardBackgroundColorCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="ROI透明度"
                                               Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Minimum="0"
                                                Maximum="1"
                                                Width="220"
                                                Value="{Binding RoiFillOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsSnapToTickEnabled="False"
                                                SmallChange="0.01"
                                                LargeChange="0.1" />
                                        <TextBlock Text="{Binding RoiFillOpacity, Mode=OneWay, StringFormat=0}"
                                                   Width="52"
                                                   Margin="10,0,4,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="%"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="任务名字号"
                                               Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Minimum="8"
                                                Maximum="48"
                                                Width="220"
                                                Value="{Binding RoiLabelFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Text="{Binding RoiLabelFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0}"
                                                 Width="72"
                                                 Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="OK阈值"
                                               Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Slider Minimum="0.001"
                                                Maximum="1"
                                                Width="220"
                                                Value="{Binding GlobalOkThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SmallChange="0.001"
                                                LargeChange="0.01" />
                                        <TextBox Text="{Binding GlobalOkThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.000}"
                                                 Width="72"
                                                 Margin="10,0,0,0" />
                                        <Button Style="{StaticResource ToolbarButton}"
                                                Content="一键应用"
                                                Margin="10,0,0,0"
                                                MinWidth="80"
                                                Command="{Binding ApplyGlobalOkThresholdCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="IO模块"
                               Style="{StaticResource SettingSectionTitle}"
                               Margin="0,16,0,8" />

                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="IP地址"
                                               Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding IoModuleHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="190"
                                             HorizontalAlignment="Left" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="端口 / 站号"
                                               Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBox Text="{Binding IoModulePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="86" />
                                        <TextBlock Text="Unit"
                                                   Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,6,0" />
                                        <TextBox Text="{Binding IoModuleUnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="66" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="参数文件与目录"
                               Style="{StaticResource SettingSectionTitle}"
                               Margin="0,16,0,8" />

                    <Border Style="{StaticResource SettingGroup}"
                            Margin="0,0,0,2">
                        <DataGrid ItemsSource="{Binding Items}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MinHeight="220"
                                  MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="150" />
                                <DataGridTextColumn Header="路径 / 值" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
