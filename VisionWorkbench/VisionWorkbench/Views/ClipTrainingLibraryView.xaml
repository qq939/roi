<UserControl x:Class="VisionWorkbench.Views.ClipTrainingLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:imagebox="clr-namespace:ImageBox;assembly=ImageBox"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="318" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <TextBlock Text="模型训练库"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="1" Margin="14,12,14,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="成品号"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ProductModels}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProductModel, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1"
                               Text="相机"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding Cameras}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                              Margin="0,6,0,0" />
                </Grid>

                <WrapPanel Grid.Row="2" Margin="14,0,14,12">
                    <Button Content="读取图片"
                            ToolTip="从文件导入图片，按当前成品号和相机模板对齐后加入图像列表。"
                            Style="{StaticResource HeaderActionButton}"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Command="{Binding AddImagesFromFileCommand}" />
                    <Button Content="相机拍照"
                            ToolTip="从当前相机拍照，按模板对齐后加入图像列表。"
                            Style="{StaticResource ToolbarButton}"
                            Command="{Binding CaptureImageCommand}" />
                </WrapPanel>

                <Grid Grid.Row="3" Margin="14,0,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="{Binding TrainingImages.Count, StringFormat=图像列表（已对齐）({0})}"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="刷新图像列表和标注状态"
                                    Command="{Binding RefreshCommand}">
                                <TextBlock Style="{StaticResource IconGlyph}"
                                           Text="&#xE72C;"
                                           FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="移除选中图像"
                                    Command="{Binding RemoveSelectedTrainingImagesCommand}">
                                <TextBlock Style="{StaticResource IconGlyph}"
                                           Text="&#xE74D;"
                                           FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="清空图像列表"
                                    Command="{Binding ClearTrainingImagesCommand}">
                                <TextBlock Style="{StaticResource IconGlyph}"
                                           Text="&#xE894;"
                                           FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="TrainingImagesList"
                             Grid.Row="1"
                             ItemsSource="{Binding TrainingImages}"
                             SelectedItem="{Binding SelectedTrainingImage, Mode=TwoWay}"
                             SelectionMode="Extended"
                             SelectionChanged="TrainingImagesList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9"
                                        Margin="0,0,0,7"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Border.ToolTip>
                                        <TextBlock Text="{Binding DetailText}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="360" />
                                    </Border.ToolTip>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Row="4"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Button Content="重建训练库"
                            ToolTip="按当前标注裁切各任务 ROI，并重建对应任务的 OK/NG 向量库；忽略和未标注不参与。"
                            Style="{StaticResource HeaderActionButton}"
                            Background="{StaticResource SuccessBrush}"
                            BorderBrush="{StaticResource SuccessBrush}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RebuildTrainingLibraryCommand}" />
                </Border>

                <Border Grid.Row="5"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="操作状态"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13"
                                   Margin="0,0,0,6" />
                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding OperationMessageDisplay, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource AppBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" />

        <Border Grid.Column="2"
                Background="{StaticResource ImageBackBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <imagebox:ImageBoxControl ImageSource="{Binding PreviewImage}"
                                          OverlayItems="{Binding TaskOverlays}"
                                          InteractionMode="Pan"
                                          ShowInfoOverlay="False"
                                          ShowBrightnessInfo="False" />
                <TextBlock Text="未选择图片"
                           Foreground="#AAB4C2"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border VerticalAlignment="Bottom"
                        Background="#CC111827"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewTitleDisplay, Mode=OneWay}"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PreviewDetailDisplay, Mode=OneWay}"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="3"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource AppBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" />

        <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <TextBlock Text="任务标签"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <WrapPanel>
                        <Button Content="全部OK"
                                Style="{StaticResource HeaderActionButton}"
                                Background="{StaticResource SuccessBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                Command="{Binding SetSelectedImageAllOkCommand}" />
                        <Button Content="全部NG"
                                Style="{StaticResource HeaderActionButton}"
                                Background="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Command="{Binding SetSelectedImageAllNgCommand}" />
                        <Button Content="全部忽略"
                                Style="{StaticResource HeaderActionButton}"
                                Background="#94A3B8"
                                BorderBrush="#94A3B8"
                                Command="{Binding SetSelectedImageAllIgnoredCommand}" />
                    </WrapPanel>
                </Border>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding TrainingTaskLabels}"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="10,10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Margin="0,0,0,9"
                                    Background="White"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding TaskName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountsTextDisplay, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{Binding StateBackground}"
                                            BorderBrush="{Binding StateBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StateTextDisplay, Mode=OneWay}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <WrapPanel Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,10,0,0">
                                        <Button Content="未标注"
                                                Style="{StaticResource HeaderActionButton}"
                                                Background="#EC4899"
                                                BorderBrush="#DB2777"
                                                Command="{Binding SetUnlabeledCommand}" />
                                        <Button Content="OK"
                                                Style="{StaticResource HeaderActionButton}"
                                                Background="{StaticResource SuccessBrush}"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                Command="{Binding SetOkCommand}" />
                                        <Button Content="NG"
                                                Style="{StaticResource HeaderActionButton}"
                                                Background="{StaticResource DangerBrush}"
                                                BorderBrush="{StaticResource DangerBrush}"
                                                Command="{Binding SetNgCommand}" />
                                        <Button Content="忽略"
                                                Style="{StaticResource HeaderActionButton}"
                                                Background="#94A3B8"
                                                BorderBrush="#94A3B8"
                                                Command="{Binding SetIgnoredCommand}" />
                                        <Button Content="任务样本库"
                                                Style="{StaticResource HeaderActionButton}"
                                                Background="{StaticResource PrimaryBrush}"
                                                BorderBrush="{StaticResource PrimaryBrush}"
                                                Command="{Binding DataContext.OpenTaskSampleLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="训练库统计"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13"
                                   Margin="0,0,0,6" />
                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding VectorSetStatusTextDisplay, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
