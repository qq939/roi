<UserControl x:Class="VisionWorkbench.Views.InspectionResultQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Style="{StaticResource PanelBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0">
                <Grid>
                    <TextBlock Text="数据查询"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="160,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <CheckBox Content="最后100条"
                                  IsChecked="{Binding Last100Only, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,18,0" />

                        <TextBlock Text="开始时间"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                    Width="128"
                                    Margin="0,0,14,0" />

                        <TextBlock Text="结束时间"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                    Width="128"
                                    Margin="0,0,18,0" />

                        <TextBlock Text="结果"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ResultOptions}"
                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                  Width="82"
                                  Margin="0,0,18,0" />

                        <Button Content="查询"
                                Style="{StaticResource HeaderActionButton}"
                                Background="{StaticResource PrimaryBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                Command="{Binding QueryCommand}" />
                        <Button Content="重置"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding ResetCommand}"
                                Margin="8,0,0,0" />
                        <Button Content="导出HTML"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding ExportCommand}"
                                CommandParameter="html"
                                Background="#4CAF50"
                                Foreground="White"
                                Margin="16,0,0,0" />
                        <Button Content="导出PDF"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding ExportCommand}"
                                CommandParameter="pdf"
                                Background="#FF9800"
                                Foreground="White" />
                    </WrapPanel>

                    <WrapPanel Grid.Row="1"
                               VerticalAlignment="Center"
                               Margin="0,9,0,0">
                        <TextBlock Text="成品号"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="138"
                                 Margin="0,0,14,0" />

                        <TextBlock Text="序列号"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox Text="{Binding SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="138"
                                 Margin="0,0,14,0" />

                        <TextBlock Text="相机"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox Text="{Binding CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="112"
                                 Margin="0,0,14,0" />

                        <TextBlock Text="Task"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding TaskOptions}"
                                  SelectedItem="{Binding SelectedTaskFilter, Mode=TwoWay}"
                                  Width="180" />
                    </WrapPanel>
                </Grid>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Records}"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Resources>
                    <Style x:Key="CenteredCellTextStyle" TargetType="{x:Type TextBlock}">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding DetailText}" />
                    </Style>
                    <Style x:Key="LeftCellTextStyle" TargetType="{x:Type TextBlock}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding DetailText}" />
                    </Style>
                    <Style TargetType="{x:Type DataGridColumnHeader}"
                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="{x:Type DataGridCell}"
                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="ToolTip" Value="{Binding DetailText}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="70"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="时间"
                                        Binding="{Binding OccurredAtText}"
                                        Width="150"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="成品号"
                                        Binding="{Binding ProductCode}"
                                        Width="130"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="序列号"
                                        Binding="{Binding SerialNumber}"
                                        Width="130"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="相机"
                                        Binding="{Binding CameraName}"
                                        Width="92"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="任务"
                                        Binding="{Binding TaskName}"
                                        Width="*"
                                        MinWidth="130"
                                        ElementStyle="{StaticResource LeftCellTextStyle}" />
                    <DataGridTemplateColumn Header="结果" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Result}"
                                           Foreground="{Binding ResultBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           ToolTip="{Binding DetailText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="OK分数"
                                        Binding="{Binding OkScoreText}"
                                        Width="86"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="NG分数"
                                        Binding="{Binding NgScoreText}"
                                        Width="86"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="耗时(ms)"
                                        Binding="{Binding ElapsedMsText}"
                                        Width="84"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTemplateColumn Header="图片" Width="136">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Content="原图"
                                            Style="{StaticResource ToolbarButton}"
                                            MinWidth="52"
                                            Height="24"
                                            Margin="0"
                                            Padding="8,0"
                                            Command="{Binding DataContext.ShowRawImageCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding RawImageButtonToolTip}" />
                                    <Button Content="ROI图"
                                            Style="{StaticResource ToolbarButton}"
                                            MinWidth="58"
                                            Height="24"
                                            Margin="6,0,0,0"
                                            Padding="8,0"
                                            Command="{Binding DataContext.ShowRoiImageCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding RoiImageButtonToolTip}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="错误"
                                        Binding="{Binding ErrorText}"
                                        Width="180"
                                        ElementStyle="{StaticResource LeftCellTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
