<Window x:Class="VisionWorkbench.Views.ProductModelDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除型号"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Style="{StaticResource PanelBorder}" Margin="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="删除型号"
                       Style="{StaticResource SectionTitle}" />

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="当前成品号"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ProductCodeText"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1"
                           Text="当前名称"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="ProductNameText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />

                <TextBlock Grid.Row="2"
                           Text="确认成品号"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBox x:Name="ConfirmationCodeBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Margin="0,6,0,0" />

                <TextBlock Grid.Row="3"
                           Text="扫码枪"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBox x:Name="ScannerBarcodeBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="28"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Margin="0,6,6,0" />
                <Button Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        ToolTip="写入确认成品号"
                        Click="FillProductCodeFromScanner_Click"
                        Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AB;" />
                </Button>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Grid.Row="2"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="取消"
                        Style="{StaticResource ToolbarButton}"
                        Click="Cancel_Click" />
                <Button Content="删除"
                        Style="{StaticResource HeaderActionButton}"
                        Background="{StaticResource DangerBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
