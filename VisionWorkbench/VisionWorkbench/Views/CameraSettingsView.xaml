<UserControl x:Class="VisionWorkbench.Views.CameraSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:imagebox="clr-namespace:ImageBox;assembly=ImageBox"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <TextBlock Text="相机"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectedCount}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Cameras}"
                         SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                         Margin="12,10,12,12"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding ProviderId}"
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding LastFrameInfo}"
                                                           Style="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right">
                                                <Ellipse Width="9"
                                                         Height="9"
                                                         Fill="{Binding ConnectionBrush}"
                                                         HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding ConnectionStateText}"
                                                           Foreground="{Binding ConnectionBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource PanelBorder}"
                Margin="8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding SelectedCamera.ConnectionBrush}"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SelectedCamera.Name}"
                                       Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedCamera.LastFrameInfo}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <imagebox:ImageBoxControl Grid.Row="1"
                                          ImageSource="{Binding SelectedCamera.Frame}"
                                          OverlayItems="{Binding SelectedCamera.Overlays}"
                                          InteractionMode="Pan"
                                          ShowInfoOverlay="False"
                                          ShowBrightnessInfo="False" />
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <TextBlock Text="相机配置"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="连接与采集"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="14"
                                   Margin="0,0,0,4" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="启用" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Grid.ColumnSpan="2"
                                      IsChecked="{Binding SelectedCamera.IsEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="设备名称" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCamera.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Text="Provider" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding ProviderOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="ProviderId"
                                      SelectedValue="{Binding SelectedProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,8,0,0" />

                            <TextBlock Grid.Row="3" Text="设备" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      ItemsSource="{Binding DeviceOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="DeviceId"
                                      SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,8,0,0" />
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource IconButton}"
                                    Command="{Binding EnumerateDevicesCommand}" ToolTip="刷新设备" Margin="6,8,0,0">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="16" />
                            </Button>

                            <TextBlock Grid.Row="4" Text="触发" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding TriggerModes}"
                                      SelectedItem="{Binding SelectedCamera.TriggerMode, Mode=TwoWay}"
                                      Margin="0,8,0,0" />

                            <TextBlock Grid.Row="5" Text="自动曝光" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <CheckBox Grid.Row="5" Grid.Column="1"
                                      IsChecked="{Binding SelectedCamera.AutoExposure, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,8,0,0" />
                            <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource IconButton}"
                                    Command="{Binding ReadExposureSettingsCommand}"
                                    ToolTip="读取相机当前曝光参数" Margin="6,8,0,0">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="16" />
                            </Button>

                            <TextBlock Grid.Row="6" Text="曝光时间(us)" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCamera.ExposureTimeUs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                     ToolTip="{Binding SelectedCamera.ExposureRangeText}"
                                     IsEnabled="{Binding SelectedCamera.IsManualExposureEnabled}"
                                     Margin="0,8,0,0" />
                        </Grid>

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="原图水印"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="14"
                                   Margin="0,0,0,4" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="文件名水印" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Grid.ColumnSpan="2"
                                      IsChecked="{Binding SelectedCamera.EnableOriginalImageFileNameWatermark, Mode=TwoWay}"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="字号(px)" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCamera.OriginalImageWatermarkFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding SelectedCamera.EnableOriginalImageFileNameWatermark}"
                                     ToolTip="允许范围：12-128"
                                     Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Text="颜色" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding SelectedCamera.OriginalImageWatermarkColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding SelectedCamera.EnableOriginalImageFileNameWatermark}"
                                     ToolTip="颜色格式：#RRGGBB"
                                     Margin="0,8,0,0" />
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}"
                                    Command="{Binding ChooseOriginalImageWatermarkColorCommand}"
                                    IsEnabled="{Binding SelectedCamera.EnableOriginalImageFileNameWatermark}"
                                    ToolTip="选择水印颜色" Margin="6,8,0,0">
                                <Grid Width="20" Height="20">
                                    <TextBlock Text="&#xE790;"
                                               Style="{StaticResource IconGlyph}"
                                               FontSize="17"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Ellipse Width="7" Height="7"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Fill="{Binding SelectedCamera.OriginalImageWatermarkBrush}"
                                             Stroke="{StaticResource AppBorderBrush}"
                                             StrokeThickness="1" />
                                </Grid>
                            </Button>

                            <TextBlock Grid.Row="3" Text="位置" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding WatermarkPositions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedCamera.OriginalImageWatermarkPosition, Mode=TwoWay}"
                                      IsEnabled="{Binding SelectedCamera.EnableOriginalImageFileNameWatermark}"
                                      Margin="0,8,0,0" />
                        </Grid>

                        <Separator Margin="0,16,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="设备信息" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCamera.DeviceDisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="状态" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedCamera.ConnectionStateText}"
                                       Foreground="{Binding SelectedCamera.ConnectionBrush}"
                                       FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Text="配置ID" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding SelectedCamera.ConfigurationId}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Text="曝光" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding SelectedCamera.ExposureReadbackText}"
                                       ToolTip="{Binding SelectedCamera.ExposureRangeText}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="4" Text="消息" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding OperationMessage}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="14,0,14,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="连接全部"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding ConnectAllCamerasCommand}" />
                        <Button Content="断开全部"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding DisconnectAllCamerasCommand}" />
                        <Button Content="拍摄全部"
                                Style="{StaticResource ToolbarButton}"
                                Command="{Binding CaptureAllCamerasCommand}" />
                    </StackPanel>
                    <Button Content="保存"
                            Style="{StaticResource SuccessButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveCameraSettingsCommand}" />
                </Grid>


            </Grid>
        </Border>
    </Grid>
</UserControl>
